<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Breathwork Studio — Breathe with Intention</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --chrome-h: 0px;
    --welcome-bg-1: #0a0618;
    --welcome-bg-2: #150b2e;
    --welcome-bg-3: #060a1f;
  }

  html, body {
    height: 100%;
    background: var(--welcome-bg-1);
    color: #e9e9f4;
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow: hidden;
    transition: background .6s ease, color .5s ease;
  }

  body.lang-hi { font-family: 'Tiro Devanagari Hindi', 'Inter', serif; }

  .font-display {
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  body.lang-hi .font-display {
    font-family: 'Tiro Devanagari Hindi', 'Outfit', serif;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* =========================================================
     VIEWS — Welcome & Breath
     ========================================================= */
  .view {
    position: fixed; inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .55s ease;
    z-index: 1;
  }
  .view.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 10;
  }

  /* =========================================================
     WELCOME VIEW
     ========================================================= */
  #welcomeView {
    overflow-y: auto;
    overflow-x: hidden;
    background:
      radial-gradient(ellipse 70% 50% at 20% 0%, rgba(120,80,240,.28), transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 15%, rgba(34,211,238,.20), transparent 60%),
      radial-gradient(ellipse 70% 60% at 50% 100%, rgba(251,113,133,.16), transparent 65%),
      linear-gradient(160deg, #0a0618 0%, #150b2e 55%, #060a1f 100%);
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.2) transparent;
  }
  #welcomeView::-webkit-scrollbar { width: 8px; }
  #welcomeView::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 999px; }

  body.theme-light #welcomeView {
    background:
      radial-gradient(ellipse 70% 50% at 20% 0%, rgba(251,191,36,.24), transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 15%, rgba(16,185,129,.22), transparent 60%),
      radial-gradient(ellipse 70% 60% at 50% 100%, rgba(236,72,153,.14), transparent 65%),
      linear-gradient(160deg, #fdfcf6 0%, #eef4e3 55%, #e6ecf8 100%);
    color: #1f2937;
  }

  .welcome-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 72px) clamp(20px, 4vw, 56px) 80px;
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(28px, 5vh, 56px);
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .85;
  }
  .brand-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    box-shadow: 0 0 18px rgba(168,85,247,.85);
    animation: brandPulse 2.6s ease-in-out infinite;
  }
  @keyframes brandPulse {
    0%,100% { transform: scale(1); box-shadow: 0 0 18px rgba(168,85,247,.85); }
    50%     { transform: scale(1.28); box-shadow: 0 0 30px rgba(34,211,238,.95); }
  }

  .lang-switch {
    display: inline-flex;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    padding: 4px;
    backdrop-filter: blur(10px);
  }
  body.theme-light .lang-switch {
    background: rgba(0,0,0,.04);
    border-color: rgba(0,0,0,.08);
  }
  .lang-switch button {
    font: inherit; font-size: 12px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    padding: 8px 16px; border-radius: 999px;
    background: transparent; color: inherit; opacity: .55;
    border: none; cursor: pointer;
    transition: all .25s ease;
  }
  .lang-switch button.active {
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    color: #0a0618;
    opacity: 1;
    box-shadow: 0 4px 16px -4px rgba(168,85,247,.7);
  }
  body.theme-light .lang-switch button.active { color: #fff; }

  /* Hero */
  .hero {
    text-align: center;
    margin-bottom: clamp(36px, 6vh, 68px);
  }
  .hero h1 {
    font-size: clamp(38px, 6.4vw, 78px);
    line-height: 1.02;
    margin-bottom: 20px;
    background: linear-gradient(120deg, #ffffff 0%, #b8c5ff 40%, #22d3ee 70%, #a855f7 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-weight: 900;
    letter-spacing: -.03em;
  }
  body.theme-light .hero h1 {
    background: linear-gradient(120deg, #0f172a 0%, #4c1d95 45%, #0e7490 75%, #be123c 100%);
    -webkit-background-clip: text; background-clip: text;
  }
  body.lang-hi .hero h1 { letter-spacing: 0; line-height: 1.15; }

  .hero p {
    font-size: clamp(15px, 1.5vw, 19px);
    max-width: 620px;
    margin: 0 auto;
    opacity: .68;
    line-height: 1.6;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    color: rgba(255,255,255,.72);
  }
  body.theme-light .hero-tag {
    background: rgba(0,0,0,.03);
    border-color: rgba(0,0,0,.08);
    color: rgba(20,25,40,.7);
  }
  .hero-tag::before {
    content: '';
    width: 6px; height: 6px; border-radius: 50%;
    background: #22d3ee;
    box-shadow: 0 0 10px #22d3ee;
  }

  /* Technique Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-bottom: 48px;
  }

  .card {
    position: relative;
    padding: 24px 22px 22px;
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
    border: 1px solid rgba(255,255,255,.10);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    overflow: hidden;
    transition: transform .35s cubic-bezier(.22,1,.36,1), border-color .35s ease, box-shadow .35s ease;
    isolation: isolate;
    --card-accent: #22d3ee;
    --card-accent-2: #0ea5e9;
  }
  body.theme-light .card {
    background: linear-gradient(160deg, rgba(255,255,255,.85), rgba(255,255,255,.55));
    border-color: rgba(20,25,40,.08);
    box-shadow: 0 4px 20px -8px rgba(40,50,90,.12);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--card-accent), transparent 40%, var(--card-accent-2));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none;
  }

  .card::after {
    content: '';
    position: absolute;
    top: -40%; right: -30%;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--card-accent), transparent 65%);
    opacity: .16;
    filter: blur(20px);
    transition: opacity .5s ease, transform .5s ease;
    pointer-events: none;
    z-index: -1;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,.18);
    box-shadow: 0 24px 50px -22px var(--card-accent);
  }
  body.theme-light .card:hover {
    border-color: rgba(20,25,40,.14);
    box-shadow: 0 24px 50px -22px var(--card-accent);
  }
  .card:hover::before { opacity: 1; }
  .card:hover::after { opacity: .32; transform: scale(1.15); }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .card-icon {
    width: 46px; height: 46px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--card-accent), var(--card-accent-2));
    color: #0a0618;
    font-size: 22px;
    font-weight: 800;
    box-shadow: 0 8px 22px -10px var(--card-accent);
    flex-shrink: 0;
  }
  body.theme-light .card-icon { color: #fff; }

  .info-btn {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.18);
    background: transparent;
    color: rgba(255,255,255,.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    font-family: 'Outfit', system-ui, serif;
    transition: all .22s ease;
    flex-shrink: 0;
    line-height: 1;
  }
  body.theme-light .info-btn {
    border-color: rgba(20,25,40,.18);
    color: rgba(20,25,40,.55);
  }
  .info-btn:hover {
    background: var(--card-accent);
    color: #0a0618;
    border-color: transparent;
    transform: scale(1.1);
  }

  .card h3 {
    font-family: 'Outfit', system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -.01em;
    margin-bottom: 4px;
    line-height: 1.15;
  }
  body.lang-hi .card h3 {
    font-family: 'Tiro Devanagari Hindi', serif;
    font-weight: 400;
  }

  .card .tagline {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--card-accent);
    font-weight: 700;
    margin-bottom: 10px;
    opacity: .9;
  }
  body.lang-hi .card .tagline { letter-spacing: 0; }

  .card .desc {
    font-size: 14px;
    line-height: 1.55;
    opacity: .72;
  }

  .card-details {
    max-height: 0;
    overflow: hidden;
    transition: max-height .5s cubic-bezier(.4,0,.2,1), margin-top .35s ease, opacity .4s ease;
    opacity: 0;
    margin-top: 0;
  }
  .card.expanded .card-details {
    max-height: 500px;
    margin-top: 18px;
    opacity: 1;
  }

  .details-section {
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.10);
    margin-bottom: 14px;
  }
  body.theme-light .details-section {
    border-top-color: rgba(20,25,40,.10);
  }
  .details-section:last-child { margin-bottom: 0; }

  .details-section h4 {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--card-accent);
    margin-bottom: 8px;
    opacity: .95;
  }
  body.lang-hi .details-section h4 { letter-spacing: 0; }

  .details-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .details-section li {
    font-size: 13px;
    line-height: 1.5;
    padding-left: 18px;
    position: relative;
    opacity: .82;
  }
  .details-section li::before {
    content: '';
    position: absolute;
    left: 0; top: 8px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--card-accent);
    opacity: .8;
  }

  .details-section p {
    font-size: 13px;
    line-height: 1.6;
    opacity: .82;
  }

  .card-start {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 10px 20px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--card-accent), var(--card-accent-2));
    color: #0a0618;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 22px -10px var(--card-accent);
    transition: transform .25s ease, box-shadow .25s ease;
    font-family: inherit;
  }
  body.theme-light .card-start { color: #fff; }
  .card-start:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -10px var(--card-accent);
  }
  .card-start .arrow { transition: transform .25s ease; }
  .card-start:hover .arrow { transform: translateX(3px); }

  .footer-note {
    text-align: center;
    font-size: 12px;
    letter-spacing: .1em;
    opacity: .38;
    text-transform: uppercase;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,.06);
  }
  body.theme-light .footer-note { border-top-color: rgba(20,25,40,.06); }

  /* =========================================================
     BREATH VIEW
     ========================================================= */
  #breathView {
    background: #05060c;
    transition: background .6s ease;
  }
  body.theme-light #breathView { background: #e6ecf8; }

  #stageWrap {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    padding: 12px;
    padding-top: calc(var(--chrome-h) + 12px);
    transition: padding-top .5s cubic-bezier(.4,0,.2,1);
  }

  #stage {
    position: relative;
    width: min(calc(100vw - 24px), calc((100vh - var(--chrome-h) - 24px) * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    transition: width .5s cubic-bezier(.4,0,.2,1), border-radius .4s ease, box-shadow .5s ease;
    box-shadow: 0 40px 100px -30px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.05);
    --phase-color: #22d3ee;
    isolation: isolate;
  }

  .stage-bg {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity .8s ease;
    pointer-events: none;
    z-index: 0;
  }
  .stage-bg.active { opacity: 1; }
  .bg-dark  {
    background:
      radial-gradient(circle at 30% 30%, rgba(120,80,240,.10), transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(34,211,238,.07), transparent 55%),
      radial-gradient(circle at 50% 45%, #1e2049 0%, #0e0f24 48%, #05060f 100%);
  }
  .bg-light {
    background:
      radial-gradient(circle at 30% 30%, rgba(251,191,36,.14), transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(16,185,129,.10), transparent 55%),
      radial-gradient(circle at 50% 45%, #fdfcf6 0%, #f3efe2 52%, #e2e9d3 100%);
  }

  #stage.theme-dark {
    --c-inhale: #22d3ee;
    --c-hold:   #c084fc;
    --c-exhale: #fb7185;
    --hud-num:  #ffffff;
    --halo:     #0e0f24;
    --track-base: rgba(255,255,255,.10);
    --border-color: rgba(255,255,255,.22);
  }
  #stage.theme-light {
    --c-inhale: #0e7490;
    --c-hold:   #7c3aed;
    --c-exhale: #be123c;
    --hud-num:  #1e293b;
    --halo:     #fdfcf6;
    --track-base: rgba(40,50,40,.14);
    --border-color: rgba(30,40,30,.18);
  }

  #scene { position: relative; display: block; width: 100%; height: 100%; z-index: 1; }

  #borderOverlay {
    position: absolute; inset: 0;
    border: 1.5px solid var(--border-color);
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity .35s ease, border-color .5s ease;
    z-index: 5;
  }
  #stage.bordered #borderOverlay { opacity: 1; }

  /* Tracks & rings */
  .track-base {
    fill: none;
    stroke: var(--track-base);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: stroke .5s ease;
  }
  .track-base.dotted {
    stroke-width: 5;
    stroke-dasharray: 0.5 22;
    stroke-linecap: round;
  }
  .track-prog-glow, .track-prog-main {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke .55s ease;
  }
  .track-prog-glow { stroke-width: 22; opacity: .18; }
  .track-prog-main { stroke-width: 5;  opacity: .95; }

  .track-group, .ring-group {
    transition: opacity .45s ease;
    will-change: opacity;
  }

  .ring {
    fill: none;
    stroke: var(--phase-color);
    transition: stroke .6s ease;
  }
  .ring-0 { stroke-width: 2.6; opacity: .34; }
  .ring-1 { stroke-width: 1.9; opacity: .22; }
  .ring-2 { stroke-width: 1.3; opacity: .13; }

  #ballGroup { filter: url(#glowBall); }
  #ballHalo { fill: var(--phase-color); opacity: .13; transition: fill .55s ease; }
  #ballMid  { fill: var(--phase-color); opacity: .32; transition: fill .55s ease; }
  #ballRing { stroke: var(--phase-color); transition: stroke .55s ease; }
  #ballCore { fill: #ffffff; }

  /* HUD */
  #hudLabel, #hudNum {
    font-family: 'Outfit', 'Inter', system-ui, sans-serif;
    text-anchor: middle;
    dominant-baseline: middle;
    paint-order: stroke fill;
    stroke-linejoin: round;
    stroke-linecap: round;
    pointer-events: none;
  }
  #hudLabel {
    font-weight: 800;
    letter-spacing: .14em;
    fill: var(--phase-color);
    stroke: var(--halo);
    stroke-width: 13px;
    transition: fill .6s ease, stroke .5s ease;
  }
  #hudNum {
    font-weight: 900;
    fill: var(--hud-num);
    stroke: var(--halo);
    stroke-width: 16px;
    transition: fill .5s ease, stroke .5s ease;
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform;
  }

  /* =========================================================
     BREATH VIEW CHROME (top bar)
     ========================================================= */
  #breathTopbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    pointer-events: none;
  }
  #breathTopbar > * { pointer-events: auto; }

  .tb-left, .tb-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(8, 10, 20, 0.72);
    border: 1px solid rgba(255,255,255,0.10);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 10px 34px -12px rgba(0,0,0,.9);
    color: rgba(255,255,255,.85);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .02em;
    cursor: pointer;
    transition: all .22s ease;
    font-family: inherit;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .pill:hover { color: #fff; background: rgba(30, 34, 52, 0.85); }
  .pill.icon-only { padding: 8px 10px; }
  .pill svg { width: 16px; height: 16px; }
  .pill.rec {
    background: rgba(220, 38, 38, 0.18);
    border-color: rgba(248, 113, 113, 0.35);
    color: #fca5a5;
  }
  .pill.rec:hover { background: rgba(220, 38, 38, 0.30); color: #fecaca; }
  .pill.rec.active {
    background: linear-gradient(180deg, #ff4d6d, #d61f43);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 0 0 1px rgba(255,120,140,.5), 0 6px 20px -6px rgba(255,60,90,.9);
  }

  .tech-chip {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.55);
    padding: 0 4px;
  }
  body.lang-hi .tech-chip { letter-spacing: 0; }

  /* Cycle counter badge */
  #cycleBadge {
    position: absolute;
    top: 18px; right: 18px;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 12px;
    border-radius: 999px;
    background: rgba(8, 10, 20, 0.55);
    border: 1px solid rgba(255,255,255,.10);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: rgba(255,255,255,.85);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .06em;
    transition: background .5s ease, border-color .5s ease, color .5s ease, opacity .35s ease;
    pointer-events: none;
    user-select: none;
  }
  #stage.theme-light #cycleBadge {
    background: rgba(255,255,255,.6);
    border-color: rgba(20,25,40,.10);
    color: #1f2937;
  }
  #cycleBadge .label {
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .62;
    font-weight: 600;
  }
