  /* =========================================================
     AUDIO ENGINE
     ========================================================= */
  let ac = null;
  let masterGain = null;
  let droneGain = null;
  let droneFilter = null;
  let droneNoise = null;
  let droneOsc = null;
  let droneOscGain = null;

  const CHIME_FREQ = { Inhale: 587.33, Hold: 880.0, Exhale: 440.0 };

  function ensureAudio() {
    if (ac) {
      if (ac.state === 'suspended') ac.resume();
      return;
    }
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    ac = new Ctx();
    masterGain = ac.createGain();
    masterGain.gain.value = state.volume;
    masterGain.connect(ac.destination);
    buildDrone();
  }

  function buildDrone() {
    const seconds = 5;
    const len = Math.floor(ac.sampleRate * seconds);
    const buf = ac.createBuffer(1, len, ac.sampleRate);
    const data = buf.getChannelData(0);
    let last = 0;
    for (let i = 0; i < len; i++) {
      const white = Math.random() * 2 - 1;
      last = (last + 0.02 * white) / 1.02;
      data[i] = last * 3.2;
    }
    droneNoise = ac.createBufferSource();
    droneNoise.buffer = buf;
    droneNoise.loop = true;
    droneFilter = ac.createBiquadFilter();
    droneFilter.type = 'lowpass';
    droneFilter.frequency.value = 260;
    droneFilter.Q.value = 0.6;
    droneGain = ac.createGain();
    droneGain.gain.value = 0;
    droneNoise.connect(droneFilter);
    droneFilter.connect(droneGain);
    droneGain.connect(masterGain);
    droneNoise.start();

    droneOsc = ac.createOscillator();
    droneOsc.type = 'sine';
    droneOsc.frequency.value = 55;
    droneOscGain = ac.createGain();
    droneOscGain.gain.value = 0.14;
    droneOsc.connect(droneOscGain);
    droneOscGain.connect(droneGain);
    droneOsc.start();
  }

  function modulateDrone(label) {
    if (!ac || !droneGain) return;
    const now = ac.currentTime;
    if (label === 'Inhale') {
      droneGain.gain.setTargetAtTime(0.20, now, 1.0);
      droneFilter.frequency.setTargetAtTime(560, now, 1.4);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(60.5, now, 1.4);
    } else if (label === 'Exhale') {
      droneGain.gain.setTargetAtTime(0.10, now, 1.4);
      droneFilter.frequency.setTargetAtTime(190, now, 1.7);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(49.5, now, 1.7);
    } else {
      droneGain.gain.setTargetAtTime(0.155, now, 0.9);
      droneFilter.frequency.setTargetAtTime(360, now, 1.1);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(55, now, 1.1);
    }
  }

  function setDroneActive(on) {
    state.drone = on;
    const sw = $('droneSwitch');
    sw.classList.toggle('on', on);
    sw.setAttribute('aria-checked', String(on));
    if (!ac) return;
    if (on) modulateDrone(getTech().phases[state.phaseIndex].label);
    else droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.4);
  }

  function playChime(label, customFreq) {
    if (!ac) return;
    const now = ac.currentTime;
    const base = customFreq || CHIME_FREQ[label] || 528;
    const out = ac.createGain();
    out.gain.setValueAtTime(0.0001, now);
    out.gain.exponentialRampToValueAtTime(0.26, now + 0.015);
    out.gain.exponentialRampToValueAtTime(0.0001, now + 2.4);
    out.connect(masterGain);

    [
      { mult: 1.0,  gain: 1.00, type: 'sine' },
      { mult: 2.0,  gain: 0.32, type: 'sine' },
      { mult: 3.01, gain: 0.13, type: 'triangle' },
      { mult: 4.98, gain: 0.05, type: 'sine' }
    ].forEach((p) => {
      const o = ac.createOscillator();
      o.type = p.type;
      o.frequency.value = base * p.mult;
      const g = ac.createGain();
      g.gain.value = p.gain;
      o.connect(g);
      g.connect(out);
      o.start(now);
      o.stop(now + 2.6);
    });
  }

