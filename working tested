  /* =========================================================
     SCENE CONSTRUCTION
     ========================================================= */
  function buildScenes() {
    TECHNIQUES.forEach((tech) => {
      /* Rings */
      const ringG = svgEl('g', { class: 'ring-group' });
      ringG.style.opacity = '0';
      const ringEls = tech.rings.base.map((r, i) => {
        const c = svgEl('circle', {
          cx: tech.rings.cx,
          cy: tech.rings.cy,
          r: r,
          class: 'ring ring-' + i
        });
        c.dataset.base = String(r);
        ringG.appendChild(c);
        return c;
      });
      ringsLayer.appendChild(ringG);

      /* Track */
      const trackG = svgEl('g', { class: 'track-group' });
      trackG.style.opacity = '0';

      const baseAttrs = Object.assign({}, tech.base.attrs, { class: 'track-base' });
      const baseEl = svgEl(tech.base.shape, baseAttrs);
      if (tech.base.dotted) baseEl.classList.add('dotted');
      trackG.appendChild(baseEl);

      const progPairs = tech.phases.map((p) => {
        const len = Math.hypot(p.b[0] - p.a[0], p.b[1] - p.a[1]);

        const glow = svgEl('line', {
          x1: p.a[0], y1: p.a[1], x2: p.b[0], y2: p.b[1],
          class: 'track-prog-glow'
        });
        const main = svgEl('line', {
          x1: p.a[0], y1: p.a[1], x2: p.b[0], y2: p.b[1],
          class: 'track-prog-main'
        });

        [glow, main].forEach((el) => {
          el.setAttribute('stroke-dasharray', len);
          el.setAttribute('stroke-dashoffset', len);
        });

        const colorVar = 'var(--c-' + p.label.toLowerCase() + ')';
        glow.style.stroke = colorVar;
        main.style.stroke = colorVar;

        trackG.appendChild(glow);
        trackG.appendChild(main);
        return { glow, main, len };
      });

      tracksLayer.appendChild(trackG);
      scenes[tech.id] = { tech, ringG, ringEls, trackG, progPairs };
    });
  }

  /* =========================================================
     RENDERING
     ========================================================= */
  function applyPhaseColor(label) {
    const v = getComputedStyle(stage)
      .getPropertyValue('--c-' + label.toLowerCase())
      .trim();
    if (v) stage.style.setProperty('--phase-color', v);
  }

  function applyHudLayout() {
    const h = getTech().hud;
    hudLabel.setAttribute('x', h.labelX);
    hudLabel.setAttribute('y', h.labelY);
    hudLabel.setAttribute('font-size', h.labelSize);
    hudNum.setAttribute('x', h.numX);
    hudNum.setAttribute('y', h.numY);
    hudNum.setAttribute('font-size', h.numSize);
  }

  function renderFrame() {
    const tech = getTech();
    const scene = scenes[tech.id];
    if (!scene) return;

    const phase = tech.phases[state.phaseIndex];
    const durMs = phase.dur * 1000;
    const tt = clamp(state.phaseElapsed / durMs, 0, 1);
    const e = easeInOutSine(tt);

    const bx = lerp(phase.a[0], phase.b[0], e);
    const by = lerp(phase.a[1], phase.b[1], e);
    ballGroup.setAttribute('transform', 'translate(' + bx.toFixed(2) + ' ' + by.toFixed(2) + ')');

    for (let i = 0; i < scene.progPairs.length; i++) {
      const pair = scene.progPairs[i];
      let off;
      if (i < state.phaseIndex) off = 0;
      else if (i > state.phaseIndex) off = pair.len;
      else off = pair.len * (1 - e);
      pair.main.setAttribute('stroke-dashoffset', off);
      pair.glow.setAttribute('stroke-dashoffset', off);
    }

    state.breath = lerp(state.ringStart, state.ringTarget, e);
    const scale = 0.72 + 0.43 * state.breath;
    for (let i = 0; i < scene.ringEls.length; i++) {
      const el = scene.ringEls[i];
      el.setAttribute('r', (parseFloat(el.dataset.base) * scale).toFixed(2));
    }

    const remaining = Math.max(0, phase.dur - state.phaseElapsed / 1000);
    const n = Math.max(1, Math.ceil(remaining));

    if (n !== state.lastNum) {
      state.lastNum = n;
      hudNum.textContent = String(n);
      if (state.playing && hudNum.animate) {
        hudNum.animate(
          [
            { transform: 'scale(1.20)', opacity: 0.82 },
            { transform: 'scale(1)',    opacity: 1 }
          ],
          { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)' }
        );
      }
    }
  }

  /* =========================================================
     PHASE / PLAYBACK
     ========================================================= */
  function enterPhase(index, silent) {
    const tech = getTech();
    const prevIndex = state.phaseIndex;
    state.phaseIndex = index;
    state.phaseElapsed = 0;

    const phase = tech.phases[index];

    state.ringStart = state.breath;
    state.ringTarget =
      phase.label === 'Inhale' ? 1 :
      phase.label === 'Exhale' ? 0 :
      state.breath;

    applyPhaseColor(phase.label);
    hudLabel.textContent = phase.label.toUpperCase();
    state.lastNum = null;

    if (!silent) {
      if (state.chime) {
        ensureAudio();
        playChime(phase.label, phase.chime);
      }
      if (state.drone) modulateDrone(phase.label);

      if (hudLabel.animate) {
        hudLabel.animate(
          [{ opacity: 0.0 }, { opacity: 1.0 }],
          { duration: 420, easing: 'ease-out' }
        );
      }
    }
  }

  function onCycleComplete() {
    state.loopCount += 1;
    cycleCount.textContent = String(state.loopCount);
    if (cycleCount.animate) {
      cycleCount.animate(
        [
          { transform: 'scale(1)',   filter: 'brightness(1)' },
          { transform: 'scale(1.55)', filter: 'brightness(1.7)', offset: 0.35 },
          { transform: 'scale(1)',   filter: 'brightness(1)' }
        ],
        { duration: 620, easing: 'cubic-bezier(.22,1,.36,1)' }
      );
    }
    if (cycleBadge.animate) {
      cycleBadge.animate(
        [
          { transform: 'scale(1)' },
          { transform: 'scale(1.06)', offset: 0.3 },
          { transform: 'scale(1)' }
        ],
        { duration: 520, easing: 'cubic-bezier(.22,1,.36,1)' }
      );
    }
  }

  function resetPlayback() {
    state.playing = false;
    state.started = false;
    state.phaseIndex = 0;
    state.phaseElapsed = 0;
    state.breath = 0;
    state.ringStart = 0;
    state.ringTarget = 0;
    state.lastNum = null;
    state.loopCount = 0;
    cycleCount.textContent = '0';

    const tech = getTech();
    const scene = scenes[tech.id];
    if (scene) {
      scene.progPairs.forEach((pair) => {
        pair.main.setAttribute('stroke-dashoffset', pair.len);
        pair.glow.setAttribute('stroke-dashoffset', pair.len);
      });
    }

    applyHudLayout();

    const phase = tech.phases[0];
    applyPhaseColor(phase.label);
    hudLabel.textContent = phase.label.toUpperCase();
    hudNum.textContent = String(phase.dur);

    if (ac && droneGain) {
      droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.4);
    }

    renderFrame();
  }

  function togglePlay() {
    ensureAudio();

    if (state.playing) {
      state.playing = false;
      if (state.drone && ac && droneGain) {
        droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.35);
      }
    } else {
      if (!state.started) {
        state.started = true;
        enterPhase(0, false);
      } else {
        const phase = getTech().phases[state.phaseIndex];
        if (state.chime) playChime(phase.label, phase.chime);
        if (state.drone) modulateDrone(phase.label);
      }
      state.playing = true;
      lastT = performance.now();
    }
  }

  /* =========================================================
     MAIN LOOP
     ========================================================= */
  let lastT = performance.now();

  function loop(now) {
    const dt = Math.min(now - lastT, 120);
    lastT = now;

    if (state.playing) {
      const tech = getTech();
      state.phaseElapsed += dt;

      let guard = 0;
      let phase = tech.phases[state.phaseIndex];

      while (state.phaseElapsed >= phase.dur * 1000 && guard++ < 16) {
        state.phaseElapsed -= phase.dur * 1000;
        const next = (state.phaseIndex + 1) % tech.phases.length;
        if (next === 0) onCycleComplete();
        enterPhase(next, false);
        phase = tech.phases[state.phaseIndex];
      }

      renderFrame();
    }

    requestAnimationFrame(loop);
  }

  /* =========================================================
     VIEW SWITCHING
     ========================================================= */
  function openTechnique(id) {
    if (!scenes[id]) return;
    state.techId = id;
    state.inBreathView = true;

    Object.keys(scenes).forEach((k) => {
      const on = k === id;
      scenes[k].trackG.style.opacity = on ? '1' : '0';
      scenes[k].ringG.style.opacity  = on ? '1' : '0';
    });

    techChip.textContent = getTech()[state.lang].name;

    welcomeView.classList.remove('active');
    breathView.classList.add('active');

    resetPlayback();
    updateChromeHeight();

    requestAnimationFrame(() => {
      state.playing = true;
      state.started = true;
      enterPhase(0, false);
      lastT = performance.now();
    });
  }

  function goBackToWelcome() {
    state.inBreathView = false;
    state.playing = false;
    if (state.drone && ac && droneGain) {
      droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.35);
    }
    if (state.recording) setRecording(false);
    closeSettings();
    breathView.classList.remove('active');
    welcomeView.classList.add('active');
  }

  /* =========================================================
     THEME / SETTINGS
     ========================================================= */
  function setTheme(name) {
    state.theme = name;
    stage.classList.remove('theme-dark', 'theme-light');
    stage.classList.add('theme-' + name);
    document.body.classList.remove('theme-dark', 'theme-light');
    document.body.classList.add('theme-' + name);

    Object.keys(bgLayers).forEach((k) => {
      if (bgLayers[k]) bgLayers[k].classList.toggle('active', k === name);
    });

    $$('#themeSeg button').forEach((b) => {
      b.classList.toggle('active', b.dataset.theme === name);
    });

    applyPhaseColor(getTech().phases[state.phaseIndex].label);
  }

  function setLang(lang) {
    state.lang = lang;
    document.body.classList.remove('lang-en', 'lang-hi');
    document.body.classList.add('lang-' + lang);

    // Update all i18n text nodes
    $$('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      el.textContent = t(key);
    });

    // Language switch buttons
    $$('.lang-switch button').forEach((b) => {
      b.classList.toggle('active', b.dataset.lang === lang);
    });
    $$('#langSeg button').forEach((b) => {
      b.classList.toggle('active', b.dataset.lang === lang);
    });

    // Rebuild cards to reflect language
    buildCards();

    // Update chip text in breath view
    techChip.textContent = getTech()[lang].name;
  }

  function updateBorder() {
    stage.classList.toggle('bordered', state.border);
    const sw = $('borderSwitch');
    sw.classList.toggle('on', state.border);
    sw.setAttribute('aria-checked', String(state.border));
  }

  function setRecording(on) {
    state.recording = on;
    document.body.classList.toggle('recording', on);
    $('recBtn').classList.toggle('active', on);
    updateChromeHeight();
  }

  function updateChromeHeight() {
    let h = 0;
    if (state.inBreathView && !state.recording) {
      const tb = $('breathTopbar');
      h = tb ? tb.offsetHeight + 8 : 72;
    }
    document.documentElement.style.setProperty('--chrome-h', h + 'px');
  }

  /* =========================================================
     SETTINGS DRAWER
     ========================================================= */
  function openSettings() {
    settingsPanel.classList.add('open');
    settingsPanel.setAttribute('aria-hidden', 'false');
    settingsBackdrop.classList.add('open');
  }
  function closeSettings() {
    settingsPanel.classList.remove('open');
    settingsPanel.setAttribute('aria-hidden', 'true');
    settingsBackdrop.classList.remove('open');
  }

  /* =========================================================
     KEYBOARD
     ========================================================= */
  function onKey(ev) {
    const tag = (ev.target && ev.target.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;

    const k = (ev.key || '').toLowerCase();

    if (ev.code === 'Space' || k === ' ') {
      if (state.inBreathView) {
        ev.preventDefault();
        togglePlay();
      }
      return;
    }
    if (k === 'r') {
      ev.preventDefault();
      if (state.inBreathView) setRecording(!state.recording);
      return;
    }
    if (k === 'escape') {
      if (state.recording) { setRecording(false); return; }
      if (settingsPanel.classList.contains('open')) { closeSettings(); return; }
      if (state.inBreathView) { goBackToWelcome(); return; }
      return;
    }
    if (k === 's') {
      if (settingsPanel.classList.contains('open')) closeSettings();
      else openSettings();
      return;
    }
    if (k === 'l') {
      setLang(state.lang === 'en' ? 'hi' : 'en');
      return;
    }
    if (k === 'b') {
      state.border = !state.border;
      updateBorder();
      return;
    }
    if (k >= '1' && k <= '5') {
      const idx = parseInt(k, 10) - 1;
      if (TECHNIQUES[idx]) {
        if (!state.inBreathView) openTechnique(TECHNIQUES[idx].id);
        else {
          state.techId = TECHNIQUES[idx].id;
          Object.keys(scenes).forEach((id) => {
            const on = id === TECHNIQUES[idx].id;
            scenes[id].trackG.style.opacity = on ? '1' : '0';
            scenes[id].ringG.style.opacity  = on ? '1' : '0';
          });
          techChip.textContent = getTech()[state.lang].name;
          resetPlayback();
          requestAnimationFrame(() => {
            state.playing = true;
            state.started = true;
            enterPhase(0, false);
            lastT = performance.now();
          });
        }
      }
      return;
    }
  }

  /* =========================================================
     BINDING
     ========================================================= */
  function bindUI() {
    // Language switch (welcome)
    $$('.lang-switch button').forEach((b) => {
      b.addEventListener('click', () => setLang(b.dataset.lang));
    });
    // Language switch (settings)
    $$('#langSeg button').forEach((b) => {
      b.addEventListener('click', () => setLang(b.dataset.lang));
    });

    // Theme segment
    $$('#themeSeg button').forEach((b) => {
      b.addEventListener('click', () => setTheme(b.dataset.theme));
    });

    // Toggles
    $('chimeSwitch').addEventListener('click', () => {
      state.chime = !state.chime;
      const sw = $('chimeSwitch');
      sw.classList.toggle('on', state.chime);
      sw.setAttribute('aria-checked', String(state.chime));
      if (state.chime) {
        ensureAudio();
        const phase = getTech().phases[state.phaseIndex];
        playChime(phase.label, phase.chime);
      }
    });

    $('droneSwitch').addEventListener('click', () => {
      ensureAudio();
      setDroneActive(!state.drone);
    });

    $('borderSwitch').addEventListener('click', () => {
      state.border = !state.border;
      updateBorder();
    });

    $('volSlider').addEventListener('input', (e) => {
      state.volume = parseInt(e.target.value, 10) / 100;
      $('volDisplay').textContent = e.target.value + '%';
      if (ac && masterGain) {
        masterGain.gain.setTargetAtTime(state.volume, ac.currentTime, 0.05);
      }
    });

    // Breath view chrome
    $('backBtn').addEventListener('click', goBackToWelcome);
    $('recBtn').addEventListener('click', () => setRecording(!state.recording));
    $('exitRecBtn').addEventListener('click', () => setRecording(false));
    $('settingsBtn').addEventListener('click', openSettings);
    $('settingsClose').addEventListener('click', closeSettings);
    settingsBackdrop.addEventListener('click', closeSettings);

    // Stage click — toggle play
    stage.addEventListener('click', (e) => {
      if (state.recording) return;
      // ignore clicks on cycle badge
      if (e.target.closest('#cycleBadge')) return;
      togglePlay();
    });

    // Keyboard
    window.addEventListener('keydown', onKey);
    window.addEventListener('resize', updateChromeHeight);

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => updateChromeHeight());
      const tb = $('breathTopbar');
      if (tb) ro.observe(tb);
    }

    // Audio unlock
    const unlock = () => {
      ensureAudio();
      window.removeEventListener('pointerdown', unlock);
      window.removeEventListener('keydown', unlock);
    };
    window.addEventListener('pointerdown', unlock);
    window.addEventListener('keydown', unlock);

    // Recording mode hover to show exit button
    let hoverTimer = null;
    const exitBtn = $('exitRecBtn');
    document.addEventListener('mousemove', (e) => {
      if (!state.recording) return;
      if (e.clientY < 90 && e.clientX < 220) {
        exitBtn.classList.add('show');
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => exitBtn.classList.remove('show'), 2400);
      }
    });
  }

  /* =========================================================
     INIT
     ========================================================= */
  function init() {
    buildScenes();
    buildCards();
    bindUI();

    setLang('en');
    setTheme('dark');
    updateBorder();
    state.border = true;
    updateBorder();

    requestAnimationFrame(() => {
      updateChromeHeight();
      requestAnimationFrame(updateChromeHeight);
    });

    requestAnimationFrame(loop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
