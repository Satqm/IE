<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Breathing Exercise Tool — Pro Overlay</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0; height: 100%;
    background: #05060c;
    overflow: hidden;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition: background .45s ease;
  }

  :root { --chrome-h: 96px; }

  /* ============ STAGE ============ */
  #stageWrap {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    padding: 12px;
    padding-top: calc(var(--chrome-h) + 12px);
    transition: padding-top .5s cubic-bezier(.4,0,.2,1);
  }

  #stage {
    position: relative;
    width: min(calc(100vw - 24px), calc((100vh - var(--chrome-h) - 24px) * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    transition: width .5s cubic-bezier(.4,0,.2,1), border-radius .4s ease, box-shadow .4s ease;
    box-shadow: 0 40px 100px -30px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.06);
    --phase-color: #38bdf8;
    isolation: isolate;
  }

  #stage.theme-dark {
    background: radial-gradient(circle at 50% 45%, #1b1c3d 0%, #0e0f24 48%, #05060f 100%);
    --c-inhale: #38bdf8;
    --c-hold:   #c084fc;
    --c-exhale: #fb7185;
    --hud-num:  #ffffff;
    --track-base: rgba(255,255,255,.10);
    --halo: #1b1c3d;
    --border-color: rgba(255,255,255,.22);
  }

  #stage.theme-light {
    background: radial-gradient(circle at 50% 45%, #fdfcf6 0%, #f3efe2 52%, #e4ead8 100%);
    --c-inhale: #0369a1;
    --c-hold:   #6d28d9;
    --c-exhale: #be123c;
    --hud-num:  #1f2937;
    --track-base: rgba(40,50,40,.13);
    --halo: #fdfcf6;
    --border-color: rgba(30,40,30,.16);
  }

  #stage.theme-green {
    background: #00FF00;
    --c-inhale: #0066ff;
    --c-hold:   #9400d3;
    --c-exhale: #ff0044;
    --hud-num:  #0a0a0a;
    --track-base: rgba(0,0,0,.22);
    --halo: #00FF00;
    --border-color: rgba(0,0,0,.35);
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  body.recording #stage { box-shadow: none !important; }
  body.recording #stage.theme-green { border-radius: 0 !important; }

  #scene { display: block; width: 100%; height: 100%; }

  /* ============ BORDER OVERLAY ============ */
  #borderOverlay {
    position: absolute; inset: 0;
    border: 1.5px solid var(--border-color);
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity .35s ease;
    z-index: 5;
  }
  #stage.bordered #borderOverlay { opacity: 1; }
  #stage.theme-green #borderOverlay { border-radius: 0; }

  /* ============ TRACKS ============ */
  .track-base {
    fill: none;
    stroke: var(--track-base);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: stroke .45s ease;
  }
  .track-base.dotted {
    stroke-width: 4.5;
    stroke-dasharray: 0.5 20;
    stroke-linecap: round;
  }

  .track-prog-glow,
  .track-prog-main {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke .55s ease;
  }
  .track-prog-glow { stroke-width: 20; opacity: .16; }
  .track-prog-main { stroke-width: 4.5; opacity: .95; }

  .theme-green .track-prog-glow { display: none; }

  /* ============ RINGS ============ */
  .ring {
    fill: none;
    stroke: var(--phase-color);
    transition: stroke .6s ease;
  }
  .ring-0 { stroke-width: 2.4; opacity: .34; }
  .ring-1 { stroke-width: 1.8; opacity: .22; }
  .ring-2 { stroke-width: 1.2; opacity: .13; }

  .theme-green .ring-0 { opacity: .55; stroke-width: 3; }
  .theme-green .ring-1 { opacity: .38; stroke-width: 2.2; }
  .theme-green .ring-2 { opacity: .22; stroke-width: 1.6; }

  /* ============ BALL ============ */
  #ballGroup { filter: url(#glowBall); }
  .theme-green #ballGroup { filter: none; }

  #ballHalo { fill: var(--phase-color); opacity: .22; transition: fill .5s ease; }
  #ballRing { stroke: var(--phase-color); transition: stroke .5s ease; }
  #ballCore { fill: #ffffff; }

  .theme-green #ballHalo { display: none; }
  .theme-green #ballCore { fill: #ffffff; }
  .theme-green #ballRing { stroke-width: 6; }

  /* ============ HUD ============ */
  #hudLabel {
    font-weight: 800;
    letter-spacing: .14em;
    fill: var(--phase-color);
    text-anchor: middle;
    dominant-baseline: middle;
    paint-order: stroke fill;
    stroke: var(--halo);
    stroke-width: 13px;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: fill .55s ease, stroke .45s ease;
  }

  #hudNum {
    font-weight: 900;
    fill: var(--hud-num);
    text-anchor: middle;
    dominant-baseline: middle;
    paint-order: stroke fill;
    stroke: var(--halo);
    stroke-width: 16px;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: fill .45s ease, stroke .45s ease;
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform;
  }

  /* ============ TOP BAR ============ */
  #topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding: 12px 12px 0;
    pointer-events: none;
  }
  #topbar > .bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    pointer-events: auto;
    max-width: 96vw;
  }

  .ctrl-group {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 5px 7px;
    border-radius: 999px;
    background: rgba(8, 10, 20, 0.68);
    border: 1px solid rgba(255,255,255,0.10);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 10px 34px -12px rgba(0,0,0,.9);
  }

  .ctrl-label {
    font-size: 9.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(255,255,255,.36);
    padding: 0 8px 0 6px;
    font-weight: 700;
    white-space: nowrap;
  }

  .chip {
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .01em;
    padding: 6px 12px;
    border-radius: 999px;
    color: rgba(255,255,255,.72);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color .18s ease, background .18s ease, box-shadow .18s ease, transform .12s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .chip:hover { color: #fff; background: rgba(255,255,255,.09); }
  .chip:active { transform: scale(.96); }
  .chip.active {
    color: #0b0b18;
    background: linear-gradient(180deg, #ffffff 0%, #d5dbee 100%);
    box-shadow: 0 0 0 1px rgba(255,255,255,.5), 0 6px 18px -6px rgba(140,180,255,.85);
  }
  .chip.rec.active {
    color: #fff;
    background: linear-gradient(180deg, #ff4d6d 0%, #d61f43 100%);
    box-shadow: 0 0 0 1px rgba(255,120,140,.6), 0 6px 20px -6px rgba(255,60,90,.9);
  }

  #volSlider {
    -webkit-appearance: none;
    appearance: none;
    width: 68px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255,255,255,.16);
    outline: none;
    margin: 0 8px 0 4px;
    cursor: pointer;
  }
  #volSlider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: #fff;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 0 3px rgba(255,255,255,.12);
  }
  #volSlider::-moz-range-thumb {
    width: 12px; height: 12px;
    border: none;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  body.recording #topbar { display: none !important; }

  @media (max-width: 780px) {
    .ctrl-label { display: none; }
    .chip { font-size: 11px; padding: 5px 10px; }
  }
</style>
</head>
<body class="theme-dark">

<!-- ============ TOP CONTROL BAR ============ -->
<div id="topbar">
  <div class="bar-inner">

    <div class="ctrl-group">
      <span class="ctrl-label">Background</span>
      <button class="chip" data-theme="dark">Dark</button>
      <button class="chip" data-theme="light">Light</button>
      <button class="chip" data-theme="green">Green</button>
    </div>

    <div class="ctrl-group">
      <span class="ctrl-label">Pattern</span>
      <button class="chip" data-tech="box">Box</button>
      <button class="chip" data-tech="triangle">Triangle</button>
      <button class="chip" data-tech="wave">4-7-8</button>
      <button class="chip" data-tech="resonant">Resonant</button>
    </div>

    <div class="ctrl-group">
      <button class="chip" id="playBtn">▶ Play</button>
      <button class="chip" id="chimeBtn">Chime</button>
      <button class="chip" id="droneBtn">Drone</button>
      <input id="volSlider" type="range" min="0" max="100" value="70" aria-label="Volume" />
    </div>

    <div class="ctrl-group">
      <button class="chip" id="borderBtn">Border</button>
      <button class="chip rec" id="recBtn">● Record</button>
    </div>

  </div>
</div>

<!-- ============ 16:9 STAGE ============ -->
<div id="stageWrap">
  <div id="stage" class="theme-dark">

    <svg id="scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="glowBall" x="-300%" y="-300%" width="700%" height="700%" color-interpolation-filters="sRGB">
          <feGaussianBlur stdDeviation="13" result="b1"/>
          <feGaussianBlur stdDeviation="34" result="b2"/>
          <feMerge>
            <feMergeNode in="b2"/>
            <feMergeNode in="b1"/>
            <feMergeNode in="b1"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>

      <g id="ringsLayer"></g>
      <g id="tracksLayer"></g>

      <g id="ballLayer">
        <g id="ballGroup">
          <circle id="ballHalo" r="46"/>
          <circle id="ballRing" r="23" fill="none" stroke-width="4.5"/>
          <circle id="ballCore" r="12"/>
        </g>
      </g>

      <g id="hudLayer">
        <text id="hudLabel" x="800" y="342" font-size="58">INHALE</text>
        <text id="hudNum" x="800" y="512" font-size="168">4</text>
      </g>
    </svg>

    <div id="borderOverlay"></div>
  </div>
</div>

<script>
(function () {
  'use strict';

  /* =========================================================
     UTILITIES
     ========================================================= */
  const NS = 'http://www.w3.org/2000/svg';
  const $ = (id) => document.getElementById(id);
  const svgEl = (tag, attrs) => {
    const e = document.createElementNS(NS, tag);
    if (attrs) for (const k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  };
  const easeInOutSine = (t) => 0.5 - 0.5 * Math.cos(Math.PI * t);
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const lerp = (a, b, t) => a + (b - a) * t;

  /* =========================================================
     TECHNIQUE DEFINITIONS
     ========================================================= */
  const TECHNIQUES = [
    {
      id: 'box',
      name: 'Box',
      full: 'Box Breathing',
      hud:   { cx: 800, cy: 450, labelSize: 58, numSize: 168, labelDy: -108, numDy: 62 },
      rings: { cx: 800, cy: 450, base: [128, 188, 248] },
      base:  { shape: 'rect', attrs: { x: 550, y: 200, width: 500, height: 500 } },
      phases: [
        { label: 'Inhale', dur: 4, a: [550, 200],  b: [1050, 200] },
        { label: 'Hold',   dur: 4, a: [1050, 200], b: [1050, 700] },
        { label: 'Exhale', dur: 4, a: [1050, 700], b: [550, 700]  },
        { label: 'Hold',   dur: 4, a: [550, 700],  b: [550, 200]  }
      ]
    },
    {
      id: 'triangle',
      name: 'Triangle',
      full: 'Triangular Breathing',
      hud:   { cx: 800, cy: 560, labelSize: 44, numSize: 122, labelDy: -74, numDy: 44 },
      rings: { cx: 800, cy: 540, base: [112, 166, 220] },
      base:  { shape: 'polygon', attrs: { points: '480,720 800,166 1120,720' } },
      phases: [
        { label: 'Inhale', dur: 4, a: [480, 720],  b: [800, 166] },
        { label: 'Hold',   dur: 4, a: [800, 166],  b: [1120, 720] },
        { label: 'Exhale', dur: 4, a: [1120, 720], b: [480, 720] }
      ]
    },
    {
      id: 'wave',
      name: '4-7-8',
      full: '4-7-8 Breathing',
      hud:   { cx: 800, cy: 570, labelSize: 56, numSize: 160, labelDy: -104, numDy: 58 },
      rings: { cx: 800, cy: 545, base: [135, 195, 255] },
      base:  { shape: 'polyline', attrs: { points: '300,700 620,250 1180,250 1500,700' } },
      phases: [
        { label: 'Inhale', dur: 4, a: [300, 700],  b: [620, 250] },
        { label: 'Hold',   dur: 7, a: [620, 250],  b: [1180, 250] },
        { label: 'Exhale', dur: 8, a: [1180, 250], b: [1500, 700] }
      ]
    },
    {
      id: 'resonant',
      name: 'Resonant',
      full: 'Resonant Breathing',
      hud:   { cx: 800, cy: 450, labelSize: 58, numSize: 168, labelDy: -108, numDy: 62 },
      rings: { cx: 800, cy: 450, base: [155, 235, 315] },
      base:  { shape: 'line', attrs: { x1: 800, y1: 180, x2: 800, y2: 720 }, dotted: true },
      phases: [
        { label: 'Inhale', dur: 5, a: [800, 720], b: [800, 180] },
        { label: 'Exhale', dur: 5, a: [800, 180], b: [800, 720] }
      ]
    }
  ];

  /* =========================================================
     DOM REFS
     ========================================================= */
  const stage       = $('stage');
  const ringsLayer  = $('ringsLayer');
  const tracksLayer = $('tracksLayer');
  const ballGroup   = $('ballGroup');
  const hudLabel    = $('hudLabel');
  const hudNum      = $('hudNum');
  const topbar      = $('topbar');

  const scenes = {};

  /* =========================================================
     STATE
     ========================================================= */
  const state = {
    techId: 'box',
    theme: 'dark',
    playing: false,
    started: false,
    phaseIndex: 0,
    phaseElapsed: 0,
    breath: 0,
    ringStart: 0,
    ringTarget: 0,
    lastNum: null,
    recording: false,
    border: true,
    drone: false,
    chime: true,
    volume: 0.7
  };

  const getTech = () => TECHNIQUES.find((t) => t.id === state.techId) || TECHNIQUES[0];

  /* =========================================================
     AUDIO ENGINE (Web Audio API)
     ========================================================= */
  let ac = null;
  let masterGain = null;
  let droneGain = null;
  let droneFilter = null;
  let droneNoise = null;
  let droneOsc = null;
  let droneOscGain = null;

  const CHIME_FREQ = { Inhale: 587.33, Hold: 880.0, Exhale: 440.0 };

  function ensureAudio() {
    if (ac) {
      if (ac.state === 'suspended') ac.resume();
      return;
    }
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;

    ac = new Ctx();

    masterGain = ac.createGain();
    masterGain.gain.value = state.volume;
    masterGain.connect(ac.destination);

    buildDrone();
  }

  function buildDrone() {
    // ---- Brownian noise bed ----
    const seconds = 5;
    const len = Math.floor(ac.sampleRate * seconds);
    const buf = ac.createBuffer(1, len, ac.sampleRate);
    const data = buf.getChannelData(0);
    let last = 0;
    for (let i = 0; i < len; i++) {
      const white = Math.random() * 2 - 1;
      last = (last + 0.02 * white) / 1.02;
      data[i] = last * 3.2;
    }

    droneNoise = ac.createBufferSource();
    droneNoise.buffer = buf;
    droneNoise.loop = true;

    droneFilter = ac.createBiquadFilter();
    droneFilter.type = 'lowpass';
    droneFilter.frequency.value = 260;
    droneFilter.Q.value = 0.6;

    droneGain = ac.createGain();
    droneGain.gain.value = 0;

    droneNoise.connect(droneFilter);
    droneFilter.connect(droneGain);
    droneGain.connect(masterGain);
    droneNoise.start();

    // ---- Sub oscillator ----
    droneOsc = ac.createOscillator();
    droneOsc.type = 'sine';
    droneOsc.frequency.value = 55;
    droneOscGain = ac.createGain();
    droneOscGain.gain.value = 0.14;
    droneOsc.connect(droneOscGain);
    droneOscGain.connect(droneGain);
    droneOsc.start();
  }

  function modulateDrone(label) {
    if (!ac || !droneGain) return;
    const t = ac.currentTime;
    if (label === 'Inhale') {
      droneGain.gain.setTargetAtTime(0.20, t, 1.0);
      droneFilter.frequency.setTargetAtTime(560, t, 1.4);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(60.5, t, 1.4);
    } else if (label === 'Exhale') {
      droneGain.gain.setTargetAtTime(0.10, t, 1.4);
      droneFilter.frequency.setTargetAtTime(190, t, 1.7);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(49.5, t, 1.7);
    } else {
      droneGain.gain.setTargetAtTime(0.155, t, 0.9);
      droneFilter.frequency.setTargetAtTime(360, t, 1.1);
      if (droneOsc) droneOsc.frequency.setTargetAtTime(55, t, 1.1);
    }
  }

  function setDroneActive(on) {
    state.drone = on;
    $('droneBtn').classList.toggle('active', on);
    if (!ac) return;
    if (on) {
      modulateDrone(getTech().phases[state.phaseIndex].label);
    } else {
      droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.4);
    }
  }

  function playChime(label) {
    if (!ac) return;
    const t = ac.currentTime;
    const base = CHIME_FREQ[label] || 528;

    const out = ac.createGain();
    out.gain.setValueAtTime(0.0001, t);
    out.gain.exponentialRampToValueAtTime(0.26, t + 0.015);
    out.gain.exponentialRampToValueAtTime(0.0001, t + 2.4);
    out.connect(masterGain);

    const partials = [
      { mult: 1.0,  gain: 1.00, type: 'sine' },
      { mult: 2.0,  gain: 0.32, type: 'sine' },
      { mult: 3.01, gain: 0.13, type: 'triangle' },
      { mult: 4.98, gain: 0.05, type: 'sine' }
    ];

    partials.forEach((p) => {
      const o = ac.createOscillator();
      o.type = p.type;
      o.frequency.value = base * p.mult;
      const g = ac.createGain();
      g.gain.value = p.gain;
      o.connect(g);
      g.connect(out);
      o.start(t);
      o.stop(t + 2.6);
    });
  }

  /* =========================================================
     SCENE CONSTRUCTION
     ========================================================= */
  function buildScenes() {
    TECHNIQUES.forEach((tech) => {
      /* ---------- RINGS ---------- */
      const ringG = svgEl('g', { class: 'ring-group' });
      ringG.style.display = 'none';

      const ringEls = tech.rings.base.map((r, i) => {
        const c = svgEl('circle', {
          cx: tech.rings.cx,
          cy: tech.rings.cy,
          r: r,
          class: 'ring ring-' + i
        });
        c.dataset.base = String(r);
        ringG.appendChild(c);
        return c;
      });
      ringsLayer.appendChild(ringG);

      /* ---------- TRACK ---------- */
      const trackG = svgEl('g', { class: 'track-group' });
      trackG.style.display = 'none';

      const baseAttrs = Object.assign({}, tech.base.attrs, { class: 'track-base' });
      const baseEl = svgEl(tech.base.shape, baseAttrs);
      if (tech.base.dotted) baseEl.classList.add('dotted');
      trackG.appendChild(baseEl);

      const progPairs = tech.phases.map((p) => {
        const len = Math.hypot(p.b[0] - p.a[0], p.b[1] - p.a[1]);

        const glow = svgEl('line', {
          x1: p.a[0], y1: p.a[1], x2: p.b[0], y2: p.b[1],
          class: 'track-prog-glow'
        });
        const main = svgEl('line', {
          x1: p.a[0], y1: p.a[1], x2: p.b[0], y2: p.b[1],
          class: 'track-prog-main'
        });

        [glow, main].forEach((el) => {
          el.setAttribute('stroke-dasharray', len);
          el.setAttribute('stroke-dashoffset', len);
        });

        const colorVar = 'var(--c-' + p.label.toLowerCase() + ')';
        glow.style.stroke = colorVar;
        main.style.stroke = colorVar;

        trackG.appendChild(glow);
        trackG.appendChild(main);

        return { glow, main, len };
      });

      tracksLayer.appendChild(trackG);

      scenes[tech.id] = { tech, ringG, ringEls, trackG, progPairs };
    });
  }

  /* =========================================================
     RENDERING
     ========================================================= */
  function applyPhaseColor(label) {
    const v = getComputedStyle(stage)
      .getPropertyValue('--c-' + label.toLowerCase())
      .trim();
    if (v) stage.style.setProperty('--phase-color', v);
  }

  function applyHudLayout() {
    const h = getTech().hud;
    hudLabel.setAttribute('x', h.cx + h.labelSize * 0.06);
    hudLabel.setAttribute('y', h.cy + h.labelDy);
    hudLabel.setAttribute('font-size', h.labelSize);
    hudNum.setAttribute('x', h.cx);
    hudNum.setAttribute('y', h.cy + h.numDy);
    hudNum.setAttribute('font-size', h.numSize);
  }

  function renderFrame() {
    const tech = getTech();
    const scene = scenes[tech.id];
    if (!scene) return;

    const phase = tech.phases[state.phaseIndex];
    const durMs = phase.dur * 1000;
    const t = clamp(state.phaseElapsed / durMs, 0, 1);
    const e = easeInOutSine(t);

    /* ---- Glowing particle position ---- */
    const bx = lerp(phase.a[0], phase.b[0], e);
    const by = lerp(phase.a[1], phase.b[1], e);
    ballGroup.setAttribute('transform', 'translate(' + bx.toFixed(2) + ' ' + by.toFixed(2) + ')');

    /* ---- Track progress ---- */
    for (let i = 0; i < scene.progPairs.length; i++) {
      const pair = scene.progPairs[i];
      let off;
      if (i < state.phaseIndex) off = 0;
      else if (i > state.phaseIndex) off = pair.len;
      else off = pair.len * (1 - e);

      pair.main.setAttribute('stroke-dashoffset', off);
      pair.glow.setAttribute('stroke-dashoffset', off);
    }

    /* ---- Concentric rings ---- */
    state.breath = lerp(state.ringStart, state.ringTarget, e);
    const scale = 0.72 + 0.43 * state.breath;
    for (let i = 0; i < scene.ringEls.length; i++) {
      const el = scene.ringEls[i];
      el.setAttribute('r', (parseFloat(el.dataset.base) * scale).toFixed(2));
    }

    /* ---- Countdown HUD ---- */
    const remaining = Math.max(0, phase.dur - state.phaseElapsed / 1000);
    const n = Math.max(1, Math.ceil(remaining));

    if (n !== state.lastNum) {
      state.lastNum = n;
      hudNum.textContent = String(n);
      if (state.playing && hudNum.animate) {
        hudNum.animate(
          [
            { transform: 'scale(1.18)', opacity: 0.85 },
            { transform: 'scale(1)', opacity: 1 }
          ],
          { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)' }
        );
      }
    }
  }

  /* =========================================================
     PHASE / PLAYBACK LOGIC
     ========================================================= */
  function enterPhase(index, silent) {
    const tech = getTech();
    state.phaseIndex = index;
    state.phaseElapsed = 0;

    const phase = tech.phases[index];

    state.ringStart = state.breath;
    state.ringTarget =
      phase.label === 'Inhale' ? 1 :
      phase.label === 'Exhale' ? 0 :
      state.breath;

    applyPhaseColor(phase.label);
    hudLabel.textContent = phase.label.toUpperCase();
    state.lastNum = null;

    if (!silent) {
      if (state.chime) {
        ensureAudio();
        playChime(phase.label);
      }
      if (state.drone) modulateDrone(phase.label);
    }
  }

  function resetPlayback() {
    state.playing = false;
    state.started = false;
    state.phaseIndex = 0;
    state.phaseElapsed = 0;
    state.breath = 0;
    state.ringStart = 0;
    state.ringTarget = 0;
    state.lastNum = null;

    const tech = getTech();
    const scene = scenes[tech.id];

    if (scene) {
      scene.progPairs.forEach((pair) => {
        pair.main.setAttribute('stroke-dashoffset', pair.len);
        pair.glow.setAttribute('stroke-dashoffset', pair.len);
      });
    }

    applyHudLayout();

    const phase = tech.phases[0];
    applyPhaseColor(phase.label);
    hudLabel.textContent = phase.label.toUpperCase();
    hudNum.textContent = String(phase.dur);

    if (ac && droneGain) {
      droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.4);
    }

    updatePlayBtn();
    renderFrame();
  }

  function togglePlay() {
    ensureAudio();

    if (state.playing) {
      state.playing = false;
      if (state.drone && ac && droneGain) {
        droneGain.gain.setTargetAtTime(0, ac.currentTime, 0.35);
      }
    } else {
      if (!state.started) {
        state.started = true;
        enterPhase(0, false);
      } else {
        const phase = getTech().phases[state.phaseIndex];
        if (state.chime) playChime(phase.label);
        if (state.drone) modulateDrone(phase.label);
      }
      state.playing = true;
      lastT = performance.now();
    }

    updatePlayBtn();
  }

  function updatePlayBtn() {
    const b = $('playBtn');
    b.textContent = state.playing ? '❚❚ Pause' : '▶ Play';
    b.classList.toggle('active', state.playing);
  }

  /* =========================================================
     MAIN ANIMATION LOOP
     ========================================================= */
  let lastT = performance.now();

  function loop(now) {
    const dt = Math.min(now - lastT, 120);
    lastT = now;

    if (state.playing) {
      const tech = getTech();
      state.phaseElapsed += dt;

      let guard = 0;
      let phase = tech.phases[state.phaseIndex];

      while (state.phaseElapsed >= phase.dur * 1000 && guard++ < 16) {
        state.phaseElapsed -= phase.dur * 1000;
        const next = (state.phaseIndex + 1) % tech.phases.length;
        enterPhase(next, false);
        phase = tech.phases[state.phaseIndex];
      }

      renderFrame();
    }

    requestAnimationFrame(loop);
  }

  /* =========================================================
     UI WIRING
     ========================================================= */
  function setTechnique(id) {
    if (!scenes[id] || state.techId === id) {
      if (scenes[id]) {
        document.querySelectorAll('[data-tech]').forEach((b) => {
          b.classList.toggle('active', b.dataset.tech === id);
        });
      }
      if (!scenes[id]) return;
    }

    state.techId = id;

    Object.keys(scenes).forEach((k) => {
      const on = k === id;
      scenes[k].trackG.style.display = on ? '' : 'none';
      scenes[k].ringG.style.display = on ? '' : 'none';
    });

    document.querySelectorAll('[data-tech]').forEach((b) => {
      b.classList.toggle('active', b.dataset.tech === id);
    });

    resetPlayback();
  }

  function setTheme(name) {
    state.theme = name;
    stage.classList.remove('theme-dark', 'theme-light', 'theme-green');
    stage.classList.add('theme-' + name);

    document.body.style.background = name === 'green' ? '#00FF00' : '#05060c';

    document.querySelectorAll('[data-theme]').forEach((b) => {
      b.classList.toggle('active', b.dataset.theme === name);
    });

    if (name === 'green') {
      state.border = false;
      updateBorder();
    }

    applyPhaseColor(getTech().phases[state.phaseIndex].label);
  }

  function updateBorder() {
    stage.classList.toggle('bordered', state.border);
    $('borderBtn').classList.toggle('active', state.border);
  }

  function setRecording(on) {
    state.recording = on;
    document.body.classList.toggle('recording', on);
    topbar.style.display = on ? 'none' : '';
    $('recBtn').classList.toggle('active', on);
    updateChromeHeight();
  }

  function updateChromeHeight() {
    const h = state.recording ? 0 : topbar.offsetHeight + 10;
    document.documentElement.style.setProperty('--chrome-h', h + 'px');
  }

  function cycleTheme() {
    const order = ['dark', 'light', 'green'];
    const i = order.indexOf(state.theme);
    setTheme(order[(i + 1) % order.length]);
  }

  function onKey(ev) {
    const tag = (ev.target && ev.target.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;

    const k = (ev.key || '').toLowerCase();

    if (ev.code === 'Space' || k === ' ') {
      ev.preventDefault();
      togglePlay();
      return;
    }
    if (k === 'r') { ev.preventDefault(); setRecording(!state.recording); return; }
    if (k === '1') { setTechnique('box'); return; }
    if (k === '2') { setTechnique('triangle'); return; }
    if (k === '3') { setTechnique('wave'); return; }
    if (k === '4') { setTechnique('resonant'); return; }
    if (k === 'b') { state.border = !state.border; updateBorder(); return; }
    if (k === 't') { cycleTheme(); return; }
    if (k === 'm') { ensureAudio(); setDroneActive(!state.drone); return; }
    if (k === 'n') {
      state.chime = !state.chime;
      $('chimeBtn').classList.toggle('active', state.chime);
      return;
    }
  }

  function bindUI() {
    document.querySelectorAll('[data-theme]').forEach((b) => {
      b.addEventListener('click', () => setTheme(b.dataset.theme));
    });

    document.querySelectorAll('[data-tech]').forEach((b) => {
      b.addEventListener('click', () => setTechnique(b.dataset.tech));
    });

    $('playBtn').addEventListener('click', togglePlay);

    $('chimeBtn').addEventListener('click', () => {
      state.chime = !state.chime;
      $('chimeBtn').classList.toggle('active', state.chime);
      if (state.chime) {
        ensureAudio();
        playChime(getTech().phases[state.phaseIndex].label);
      }
    });

    $('droneBtn').addEventListener('click', () => {
      ensureAudio();
      setDroneActive(!state.drone);
    });

    $('borderBtn').addEventListener('click', () => {
      state.border = !state.border;
      updateBorder();
    });

    $('recBtn').addEventListener('click', () => setRecording(!state.recording));

    $('volSlider').addEventListener('input', (e) => {
      state.volume = parseInt(e.target.value, 10) / 100;
      if (ac && masterGain) {
        masterGain.gain.setTargetAtTime(state.volume, ac.currentTime, 0.05);
      }
    });

    window.addEventListener('keydown', onKey);

    window.addEventListener('resize', updateChromeHeight);

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => updateChromeHeight());
      ro.observe(topbar);
    }

    // Unlock audio on first interaction anywhere
    const unlock = () => {
      ensureAudio();
      window.removeEventListener('pointerdown', unlock);
      window.removeEventListener('keydown', unlock);
    };
    window.addEventListener('pointerdown', unlock);
    window.addEventListener('keydown', unlock);
  }

  /* =========================================================
     INIT
     ========================================================= */
  function init() {
    buildScenes();
    bindUI();

    // Defaults
    state.chime = true;
    $('chimeBtn').classList.add('active');

    setTheme('dark');

    state.border = true;
    updateBorder();

    setTechnique('box');

    // Chrome height after paint
    requestAnimationFrame(() => {
      updateChromeHeight();
      requestAnimationFrame(updateChromeHeight);
    });

    requestAnimationFrame(loop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
  </html>
